# Copy to .env and fill in. Never commit .env.

# Supabase (Project Settings → API). The anon key is designed to be public;
# row-level security protects the data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Cesium ion access token (https://ion.cesium.com/tokens). Used from Phase 2.
VITE_CESIUM_ION_TOKEN=

# Mock discovery provider (synthetic TEST DATA candidates), for checking the candidate pipeline.
# Off by default now that the Hypatia engine is registered. Set to true to list it as well.
VITE_ENABLE_MOCK_DISCOVERY=false

# Optional. Where the app reads the engine's data file from. Default: the copy shipped with the
# app (public/engine/discovery.json). Point it at a hosted copy to publish engine updates
# without rebuilding the app.
VITE_ENGINE_DATA_URL=

# AI assistant.
# While developing (`npm run dev`): put an Anthropic API key here and the assistant uses Claude.
# No VITE_ prefix: the key stays on the dev server and never reaches the browser. Never commit .env.
ANTHROPIC_API_KEY=
# Published app: address of the deployed `assistant` function (supabase/functions/assistant).
# There the key is a Supabase secret (`supabase secrets set ANTHROPIC_API_KEY=...`), not a variable here.
# Without either, the assistant answers with its built-in rules.
VITE_ASSISTANT_URL=

# Server-side only, for `npm run seed:supabase`. NEVER prefix with VITE_ (it would ship to browsers).
SUPABASE_SERVICE_ROLE_KEY=
